# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
PORT=8000

# Evaluation/runtime safety. The evaluator's default --offline mode overrides
# this value and disables provider access and LangSmith tracing.
TISW_OFFLINE=false
# Optional deterministic browser streaming fixture; use only with offline=true.
# TISW_MOCK_STREAMING=false
# Optional temporary request-correlation logs; disabled by default. Never log
# session tokens or API keys. Disable after reproducing a live issue.
# TISW_STREAM_DIAGNOSTICS=false

# LangSmith is opt-in. In langsmith 0.14.x the effective tracing switch is
# LANGSMITH_TRACING_V2 (LANGCHAIN_TRACING_V2 is the compatibility alias).
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGSMITH_PROJECT=tisw
# LANGSMITH_API_KEY=

# Comma-separated browser origins allowed to call the API
TISW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional RAG tuning (defaults are suitable for local development)
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=250
RAG_VECTOR_CANDIDATES=10
RAG_BM25_CANDIDATES=10
RAG_RRF_K=60
RAG_FINAL_TOP_K=6
RAG_MAX_FILE_SIZE_BYTES=15728640
RAG_MAX_FILES_PER_SESSION=10
